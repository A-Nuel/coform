# Backend URL for the frontend to call
# Development: leave empty (uses Vite proxy to localhost:8000)
# Production: set to your Railway/Render backend URL
VITE_API_URL=https://your-backend.railway.app/api/v1

# Backend CORS - comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
